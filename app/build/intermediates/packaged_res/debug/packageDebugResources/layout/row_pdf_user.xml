<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:contentPadding="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- =================== KHU VỰC ẢNH BÌA =================== -->
        <RelativeLayout
            android:id="@+id/coverImageRl"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="@color/gray02">

            <!-- ImageView (Thay thế cho PdfView) -->
            <ImageView
                android:id="@+id/coverIv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_book_white"
                android:contentDescription="Ảnh bìa sách" />

            <!-- ProgressBar: show while image is loading -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                android:visibility="gone"/>
        </RelativeLayout>

        <!-- =================== NỘI DUNG CHÍNH =================== -->

        <!-- 1. Title -->
        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.MaterialComponents.Headline6"
            android:text="Book Title"
            android:layout_toEndOf="@id/coverImageRl"
            android:maxLines="1"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:layout_marginEnd="5dp"/>

        <!-- 2. Category (Đặt ngay dưới Title) -->
        <TextView
            android:id="@+id/categoryTv"
            style="@style/TextAppearance.MaterialComponents.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/titleTv"
            android:layout_toEndOf="@id/coverImageRl"
            android:layout_marginTop="2dp"
            android:text="Category"
            android:textColor="@color/black"/>

        <!-- 3. Description (Neo dưới Category) -->
        <TextView
            android:id="@+id/descriptionTv"
            style="@style/TextAppearance.MaterialComponents.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/categoryTv"
            android:layout_toEndOf="@id/coverImageRl"
            android:layout_marginTop="4dp"
            android:text="Book description of max 3 line"
            android:maxLines="3"
            android:ellipsize="end"/>

        <!-- 4. Khu vực Footer (Thông tin chi tiết) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_toEndOf="@id/coverImageRl"
            android:orientation="horizontal">

            <!-- Kích thước (fileSize) -->
            <TextView
                android:id="@+id/sizeTv"
                style="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 MB"
                android:textColor="@color/black"
                android:drawablePadding="3dp"
                android:layout_marginEnd="8dp"/>

            <!-- Số trang (pagesCount - Đã thêm) -->
            <TextView
                android:id="@+id/pagesTv"
                style="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="300 trang"
                android:textColor="@color/black"
                android:drawablePadding="3dp"
                android:layout_marginEnd="8dp"/>

            <!-- Ngày thêm -->
            <TextView
                android:id="@+id/dateTv"
                style="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="dd/MM/yyyy"
                android:textColor="@color/black"
                android:gravity="end"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>